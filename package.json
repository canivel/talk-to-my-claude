{
  "name": "talk-to-my-claude",
  "version": "0.1.0",
  "private": true,
  "description": "A disclosure-first relay that lets your AI answer their AI, then hands you back only what a human actually needs to decide.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build && pnpm --filter @ttmc/web build",
    "dev": "pnpm --filter @ttmc/web dev",
    "mcp": "pnpm --filter @ttmc/mcp start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @ttmc/web lint",
    "db:generate": "pnpm --filter @ttmc/web db:generate",
    "db:push": "pnpm --filter @ttmc/web db:push"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
