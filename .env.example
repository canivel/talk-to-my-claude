# ─────────────────────────────────────────────────────────────
# Talk To My Claude — environment
#
# Nothing here is an inference API key. TTMC is a relay: the model
# runs on the user's side (their Claude, via MCP). Keep it that way.
# ─────────────────────────────────────────────────────────────

# Public origin, used to build shareable /d/<code> links and the
# `verify:` line in every disclosure footer.
TTMC_PUBLIC_URL=http://localhost:3000

# HMAC secret for signing provenance stamps (TTMC-1).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates verification of previously signed turns,
# so rotate by adding to TTMC_SIGNING_SECRET_PREVIOUS instead.
TTMC_SIGNING_SECRET=dev-only-insecure-secret-change-me
TTMC_SIGNING_SECRET_PREVIOUS=

# Storage. Leave DATABASE_URL empty to run fully in-memory (zero setup,
# state resets on restart) — this is the default for `pnpm dev`.
# Set it to a Postgres URL to persist.
DATABASE_URL=

# ── Clerk (auth) ────────────────────────────────────────────────
# Leave both empty to run in DEV_IDENTITY mode: no auth, single local
# user. The app boots and every route works without a Clerk account.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── MCP client (packages/mcp) ───────────────────────────────────
# Where the MCP server points, and the seat token it authenticates with.
# Mint a token in the web app under Settings → Connect your Claude.
TTMC_API_URL=http://localhost:3000
TTMC_TOKEN=

# ── Slack adapter (optional) ────────────────────────────────────────
# Signing secret from your Slack app's Basic Information page. Requests are
# verified against the raw body before anything is parsed — without this,
# anyone who learns your endpoint URL can make your agent speak.
SLACK_SIGNING_SECRET=
# Bot token (xoxb-…). Without it, replies are logged instead of posted, which
# is what makes `pnpm demo:slack` runnable with no Slack workspace.
SLACK_BOT_TOKEN=

# ── Auto-routing ────────────────────────────────────────────────────
# Off, empty, and strict by default. A tool that starts answering your
# colleagues the moment it is installed would be indefensible.
# Only a VERIFIED TTMC-1 signature can trigger an automatic reply; the
# boilerplate heuristic never can.
TTMC_AUTOROUTE=0
TTMC_AUTOROUTE_CHANNELS=
TTMC_AUTOROUTE_NEVER=
